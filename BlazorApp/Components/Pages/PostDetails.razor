
@page "/posts/{Id:int}"
@using ApiContracts
@using BlazorApp.HttpServices
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IPostService PostService
@inject ICommentService CommentService

<h3>Post Details</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p>@errorMessage</p>
}
else if (post == null)
{
    <p>Loading post...</p>
}
else
{
    <h4>@post.Title</h4>
    <p>@post.Body</p>
    <p>Created by User ID: @post.UserId</p>

    <hr />

    <h4>Comments</h4>

    @if (comments == null)
    {
        <p>Loading comments...</p>
    }
    else if (comments.Count == 0)
    {
        <p>No comments yet.</p>
    }
    else
    {
        @foreach (CommentDto comment in comments)
        {
            <div>
                <p>@comment.Body</p>
                <p>Comment by User ID: @comment.UserId</p>
                <hr />
            </div>
        }
    }

    <AuthorizeView>
        <Authorized Context="authContext">
            <h4>Add Comment</h4>

            <EditForm Model="@newComment" OnValidSubmit="@AddCommentAsync">
                <DataAnnotationsValidator />

                <InputTextArea @bind-Value="newComment.Body" />

                <button type="submit">Add Comment</button>
            </EditForm>

            <p>@message</p>
        </Authorized>

        <NotAuthorized>
            <p>Please log in to add a comment.</p>
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState> State { get; set; } = default!;

    private int userId;

    private PostDto? post;
    private List<CommentDto>? comments;
    private string errorMessage = "";
    private string message = "";

    private CreateCommentDto newComment = new()
    {
        Body = "",
        PostId = 0
    };

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            post = await PostService.GetPostAsync(Id);
            comments = await CommentService.GetCommentsByPostIdAsync(Id);

            newComment.PostId = Id;

            AuthenticationState authenticationState = await State;
            ClaimsPrincipal claimsPrincipal = authenticationState.User;

            if (claimsPrincipal.Identity is not null &&
                claimsPrincipal.Identity.IsAuthenticated)
            {
                string userIdAsString = claimsPrincipal.Claims
                    .Single(c => c.Type == "Id").Value;

                userId = int.Parse(userIdAsString);
                newComment.UserId = userId;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading post: {ex.Message}";
        }
    }

    private async Task AddCommentAsync()
    {
        try
        {
            newComment.UserId = userId;
            newComment.PostId = Id;

            await CommentService.AddCommentAsync(newComment);

            message = "Comment added successfully!";

            comments = await CommentService.GetCommentsByPostIdAsync(Id);

            newComment = new CreateCommentDto
            {
                Body = "",
                UserId = userId,
                PostId = Id
            };
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }
}

