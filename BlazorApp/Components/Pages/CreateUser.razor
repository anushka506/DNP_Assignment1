@page "/create-user"
@using ApiContracts
@using BlazorApp.HttpServices
@inject IUserService UserService

<h3>Create User</h3>

<EditForm Model="@newUser" OnValidSubmit="@CreateUserAsync">
    <DataAnnotationsValidator />

    <div>
        <label>Username:</label>
        <InputText @bind-Value="newUser.UserName" />
    </div>

    <div>
        <label>Password:</label>
        <InputText type="password" @bind-Value="newUser.Password" />
    </div>

    <button type="submit">Create User</button>
</EditForm>

<p>@message</p>

@code {
    private CreateUserDto newUser = new()
    {
        UserName = "",
        Password = ""
    };

    private string message = "";

    private async Task CreateUserAsync()
    {
        try
        {
            UserDto createdUser = await UserService.AddUserAsync(newUser);

            message = $"User created successfully! ID: {createdUser.Id}";

            newUser = new CreateUserDto
            {
                UserName = "",
                Password = ""
            };
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }
}